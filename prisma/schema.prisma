generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  VENDOR
  ADMIN
  SUB_ADMIN
  SUPER_ADMIN
}


enum Permission {
  GENERATE_CODES
  UPLOAD_TASKS
  APPROVE_WITHDRAWALS
  MANAGE_USERS
  SEND_NOTIFICATIONS
}



enum TaskStatus {
  ACTIVE
  INACTIVE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponStatus {
  UNUSED
  USED
}

enum WithdrawalType {
  AFFILIATE
  TASK
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String       @id @default(uuid())
  name                String
  username            String       @unique
  email               String       @unique
  password            String
  withdrawalPin       String?
  role                Role         @default(USER)
  planId              String?
  membership          MembershipPlan? @relation(fields: [planId], references: [id])
  affiliateBalance    Float        @default(0.0)
  taskBalance         Float        @default(0.0)
  totalEarnings       Float        @default(0.0)
  referralCount       Int          @default(0)
  weeklyReferralCount Int          @default(0)
  lastWeeklyReset     DateTime     @default(now())
  profilePic          String?
  customGreeting      String?
  telegramLink        String?
  customTelegramMessage String?
  bankName            String?
  accountName         String?
  accountNumber       String?
  subAdminPermissions Permission[] // PostgreSQL supports enum arrays
  hasSeenWelcomePopup Boolean      @default(false)
  pendingUpgradeThankYou String?   // Stores upgraded plan name to trigger Thank You message on dashboard

  // Tracking withdrawals on the current plan for the upgrade lock rule
  currentPlanAffiliateWithdrawals Int @default(0)
  currentPlanTaskWithdrawals      Int @default(0)

  // Spin & Win Wheel tracking
  lastSpinDate                    DateTime?
  freeSpinsRemaining              Int          @default(0)

  // Daily Login Streak tracking
  loginStreak                     Int          @default(0)
  lastDailyBonusClaim             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions      TaskSubmission[]
  assignedCoupons  CouponCode[]        @relation("AssignedTo")
  redeemedCoupons  CouponCode[]        @relation("RedeemedBy")
  withdrawals      WithdrawalRequest[]
  activityLogs     ActivityLog[]
  notifications    Notification[]      @relation("TargetedUser")
  vtuTransactions  VtuTransaction[]

  // Referrals tracking
  referralsSent     Referral[] @relation("ReferrerRelation")
  referralReceived  Referral?  @relation("ReferredRelation")
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String
  referredId    String   @unique
  paidPlanNames String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referrer      User     @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)
  referred      User     @relation("ReferredRelation", fields: [referredId], references: [id], onDelete: Cascade)
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String
  reward      Float
  link          String
  platform      String     // E.g., FACEBOOK, WHATSAPP, etc.
  targetPlan    String     @default("ALL") // "ALL", "FREE", "PRO"
  requiresProof Boolean    @default(true)
  status        TaskStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  submissions TaskSubmission[]
}

model TaskSubmission {
  id        String           @id @default(uuid())
  userId    String
  taskId    String
  proofUrl  String?
  status    SubmissionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model CouponCode {
  id               String       @id @default(uuid())
  code             String       @unique
  planId           String?
  assignedVendorId String?
  redeemedById     String?
  status           CouponStatus @default(UNUSED)
  createdAt        DateTime     @default(now())
  redeemedDate     DateTime?

  plan           MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  assignedVendor User? @relation("AssignedTo", fields: [assignedVendorId], references: [id], onDelete: SetNull)
  redeemedBy     User? @relation("RedeemedBy", fields: [redeemedById], references: [id], onDelete: SetNull)
}

model WithdrawalRequest {
  id        String           @id @default(uuid())
  userId    String
  amount    Float
  type      WithdrawalType
  status    WithdrawalStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  description String
  userId      String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id             String         @id @default(uuid())
  title          String
  message        String
  link           String?
  targetAudience String         @default("ALL")
  targetUserId   String?
  createdAt      DateTime       @default(now())

  targetUser User? @relation("TargetedUser", fields: [targetUserId], references: [id], onDelete: Cascade)
}

model PlatformSettings {
  id                     String    @id @default("1")
  name                   String    @default("EARNIX")
  tagline                String    @default("Earn More. Grow Beyond.")
  logo                   String?
  
  // Withdrawals
  minAffiliateWithdraw   Float     @default(1000.0)
  minTaskWithdraw        Float     @default(3500.0)
  freeWithdrawalOpen     Boolean   @default(true)
  proWithdrawalOpen      Boolean   @default(true)
  withdrawalPortalMode   String    @default("MANUAL") // "MANUAL" | "AUTOMATIC"
  portalOpenManual       Boolean   @default(true)
  affiliatePortalOpenManual Boolean @default(true)
  taskPortalOpenManual      Boolean @default(true)
  autoOpenSchedule       String    @default("Fridays at 8:00 AM")
  autoCloseSchedule      String    @default("Sundays at 11:59 PM")
  scheduledFreeOpenDate  DateTime?
  scheduledFreeCloseDate DateTime?
  scheduledProOpenDate   DateTime?
  scheduledProCloseDate  DateTime?
  scheduledAffiliateOpenDate  DateTime?
  scheduledAffiliateCloseDate DateTime?
  scheduledTaskOpenDate       DateTime?
  scheduledTaskCloseDate      DateTime?

  // System
  maintenanceMode        Boolean   @default(false)
  maintenanceMessage     String?
  registrationMessage    String?
  
  // Feature Toggles
  enableFreeReg          Boolean   @default(true)
  enableProReg           Boolean   @default(true)
  enableTasks            Boolean   @default(true)
  enableWithdrawals      Boolean   @default(true)
  enableReferrals        Boolean   @default(true)
  requireUpgradeForWithdrawal Boolean @default(true)
  blockFreeWithdrawal         Boolean @default(true)
  enableVtuData          Boolean   @default(true)
  vtuDataButtonClaimable Boolean   @default(true)

  // Welcome Popup
  welcomePopupEnabled      Boolean   @default(true)
  welcomePopupTitleFree    String    @default("Welcome to EARNIX!")
  welcomePopupMessageFree  String    @default("We are excited to have you on board! Start completing tasks today to earn real cash.")
  welcomePopupTitlePro     String    @default("Welcome to EARNIX PRO!")
  welcomePopupMessagePro   String    @default("Thank you for upgrading! Enjoy exclusive premium tasks and higher earnings.")
  welcomePopupLink         String?

  // AdSense
  adsenseEnabled         Boolean   @default(false)
  adsenseClientId        String?

  // Support Contacts
  supportEmail           String?   @default("Supportearnix@gmail.com")
  whatsappSupport        String?
  telegramSupport        String?

  // Currency & Earnings Mode
  affiliateCurrency      String    @default("NGN")    // "NGN" | "USD"
  usdExchangeRate        Float     @default(1600.0)
  taskEarningsMode       String    @default("CASH")   // "CASH" | "POINTS"
  pointsConversionRate   Float     @default(1.0)      // 1 NGN = X points

  updatedAt              DateTime  @updatedAt
}

model MembershipPlan {
  id                 String   @id @default(uuid())
  name               String   @unique
  price              Float    @default(0.0)
  welcomeBonus       Float    @default(0.0)
  dailyLoginBonus    Float    @default(0.0)
  taskReward         Float    @default(0.0)
  referralCommission Float    @default(0.0)
  minTaskWithdrawal  Float    @default(3500.0)
  minAffiliateWithdrawal Float @default(1000.0)
  withdrawalPortalOpen   Boolean  @default(true)
  affiliateWithdrawalOpen Boolean @default(true)
  taskWithdrawalOpen      Boolean @default(true)
  affiliateScheduledOpenDate  DateTime?
  affiliateScheduledCloseDate DateTime?
  taskScheduledOpenDate       DateTime?
  taskScheduledCloseDate      DateTime?
  description        String?
  features           String[]
  isActive           Boolean  @default(true)
  level              Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users              User[]
  coupons            CouponCode[]
}

enum VtuStatus {
  PENDING
  APPROVED
  REJECTED
  SUCCESS
  FAILED
}

enum VtuType {
  AIRTIME
  DATA
}

enum VtuNetwork {
  MTN
  AIRTEL
  GLO
  NINE_MOBILE
}

model VtuTransaction {
  id           String         @id @default(uuid())
  userId       String
  network      VtuNetwork
  type         VtuType        @default(AIRTIME)
  planOrBundle String?
  phoneNumber  String
  amount       Float
  walletSource WithdrawalType // AFFILIATE or TASK
  status       VtuStatus      @default(PENDING)
  reference    String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

